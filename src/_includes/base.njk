<!doctype html>
{% set pageLocale = locale or site.locale or 'pl' %}
{% set isPolish = pageLocale == 'pl' %}
{% set homeUrl = '/' %}
{% set homeLabel = 'Strona główna' if isPolish else 'Home' %}
{% set loginLabel = 'Logowanie' if isPolish else 'Log in' %}
{% set signupLabel = 'Rejestracja' if isPolish else 'Sign up' %}
{% set servicesLabel = 'Produkt' if isPolish else 'Product' %}
{% set howItWorksLabel = 'Jak to działa' if isPolish else 'How It Works' %}
{% set aboutLabel = 'Dlaczego ten system' if isPolish else 'Why this system' %}
{% set menuLabel = 'Menu' if isPolish else 'Menu' %}
{% set langSwitchLabel = 'EN' if isPolish else 'PL' %}
{% set langSwitchText = 'English' if isPolish else 'Polski' %}
{% set langSwitchHint = 'Wersja językowa' if isPolish else 'Language' %}
{% set featuresLabel = 'Funkcje' if isPolish else 'Features' %}
{% set pricingLabel = 'Cennik' if isPolish else 'Pricing' %}
{% set heroPrimaryCtaLabel = 'Załóż darmowe konto próbne' if isPolish else 'Create a free trial account' %}
{% set isHome = page.url == "/" %}
{% set isServicesIndex = page.url == "/services/" %}
{% set isServices = page.url and page.url.indexOf("/services/") == 0 %}
{% set isBlog = page.url and page.url.indexOf("/aktualnosci/") == 0 %}
{% set isBlogIndex = page.url == "/aktualnosci/" %}
{% set isLegal = page.url == "/polityka-prywatnosci/" or page.url == "/regulamin/" %}
{% set isStart = false %}
{% set isContact = page.url == "/pl/kontakt/" %}
{% set isWhyUs = false %}
{% set isLeadPlan = false %}
{% set isAssessment = page.url == "/ocena-gotowosci-organizacji/" %}
{% set isFaqPage = page.url == "/faq/" %}
{% set isContent = not isHome %}
{% set alternates = {} %}
{% set canonicalPath = canonicalPath or page.url %}
{% set canonicalUrl = (site.url + canonicalPath) if site and site.url and canonicalPath else canonicalPath %}
{% set organization = site.organization or {} %}
{% set organizationId = (site.url + '#organization') if site and site.url else '#organization' %}
{% set organizationLogo = (site.url + organization.logo) if site and site.url and organization.logo else organization.logo %}
{% set isPrimaryServicePage = page.url == '/' %}
{% set breadcrumbHomeUrl = homeUrl %}
{% set breadcrumbHomeLabel = homeLabel %}
{% set languageSwitchUrl = '' %}
{% set loginUrl = 'https://konto.systemjawnosciwynagrodzen.pl/login' %}
{% set signupUrl = 'https://konto.systemjawnosciwynagrodzen.pl/register' %}
<html lang="{{ pageLocale }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <script>
      document.documentElement.classList.add("js");
    </script>
    {% set metaTitle = title or "System Jawności Wynagrodzeń" %}
    {% set pageHeading = heading or metaTitle %}
    {% set metaDescription = description or "System Jawności Wynagrodzeń pomaga firmom uporządkować płace i przygotować się na transparentność wynagrodzeń." %}
    {% set pageLead = lead or description %}
    {% set defaultFeaturedImage = "/images/logo.svg" %}
    {% set effectiveImage = image %}
    {% set effectiveImageAlt = imageAlt %}
    {% set effectiveImageWidth = imageWidth %}
    {% set effectiveImageHeight = imageHeight %}
    {% if not effectiveImage and pageType != "article" %}
      {% set effectiveImage = defaultFeaturedImage %}
      {% set effectiveImageAlt = "System Jawności Wynagrodzeń" %}
      {% set effectiveImageWidth = 512 %}
      {% set effectiveImageHeight = 512 %}
    {% endif %}
    <title>{{ metaTitle | escape }}</title>
    <meta name="description" content="{{ metaDescription | escape }}" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta http-equiv="content-language" content="{{ pageLocale }}" />
    <meta name="language" content="{{ pageLocale }}" />
    {% if canonicalUrl %}
      <link rel="canonical" href="{{ canonicalUrl }}" />
      <meta property="og:url" content="{{ canonicalUrl }}" />
    {% endif %}
    {% if site and site.url and site.url.length %}
      <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ canonicalPath }}" />
    {% endif %}
    <meta property="og:site_name" content="{{ site.name if site and site.name else 'System Jawności Wynagrodzeń' }}" />
    <meta property="og:title" content="{{ metaTitle | escape }}" />
    <meta property="og:description" content="{{ metaDescription | escape }}" />
    <meta property="og:type" content="{% if pageType == 'article' %}article{% else %}website{% endif %}" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-C5DBLJVDBD"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      function gtag_report_conversion(url) {
        var callback = function () {
          if (typeof url !== 'undefined') {
            window.location = url;
          }
        };

        gtag('event', 'conversion', {
          'send_to': 'AW-16941520440/pP9oCMT9wLwcELisrI4_',
          'event_callback': callback
        });

        return false;
      }
      gtag('js', new Date());

      gtag('config', 'G-C5DBLJVDBD');
      gtag('config', 'AW-16941520440');
    </script>
    <script>
      document.addEventListener('click', function (event) {
        var signupLink = event.target.closest('a[data-signup-conversion="true"]');

        if (!signupLink) {
          return;
        }

        event.preventDefault();
        gtag_report_conversion(signupLink.href);
      });
    </script>
    {% if pageType == 'article' and date %}
      <meta property="article:published_time" content="{{ date.toISOString() }}" />
    {% endif %}
    {% if effectiveImage %}
      {% set ogImageUrl = (site.url + effectiveImage) if site and site.url else effectiveImage %}
      <meta property="og:image" content="{{ ogImageUrl | escape }}" />
      <meta name="twitter:image" content="{{ ogImageUrl | escape }}" />
      {% if effectiveImageAlt %}
        <meta property="og:image:alt" content="{{ effectiveImageAlt | escape }}" />
        <meta name="twitter:image:alt" content="{{ effectiveImageAlt | escape }}" />
      {% endif %}
      {% if effectiveImageWidth %}
        <meta property="og:image:width" content="{{ effectiveImageWidth }}" />
      {% endif %}
      {% if effectiveImageHeight %}
        <meta property="og:image:height" content="{{ effectiveImageHeight }}" />
      {% endif %}
    {% endif %}
    <meta name="twitter:card" content="{% if effectiveImage %}summary_large_image{% else %}summary{% endif %}" />
    <meta name="theme-color" content="#118C4F" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="icon" href="/favicon.svg" sizes="any" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    {% if site and site.url and site.url.length %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": {{ organizationId | json | safe }},
      "name": {{ organization.name | default(site.name) | json | safe }},
      "url": {{ site.url | json | safe }},
      {% if organizationLogo %}"logo": {{ organizationLogo | json | safe }},{% endif %}
      {% if organization.email %}"email": {{ organization.email | json | safe }},{% endif %}
      {% if organization.telephone %}"telephone": {{ organization.telephone | json | safe }},{% endif %}
      {% if organization.sameAs and organization.sameAs.length %}"sameAs": {{ organization.sameAs | json | safe }},{% endif %}
      "address": {
        "@type": "PostalAddress",
        {% if organization.addressLocality %}"addressLocality": {{ organization.addressLocality | json | safe }},{% endif %}
        {% if organization.addressRegion %}"addressRegion": {{ organization.addressRegion | json | safe }},{% endif %}
        {% if organization.addressCountry %}"addressCountry": {{ organization.addressCountry | json | safe }}{% else %}"addressCountry": "PL"{% endif %}
      },
      "areaServed": [
        { "@type": "City", "name": "Warsaw" },
        { "@type": "Country", "name": "Poland" }
      ],
      "contactPoint": [{
        "@type": "ContactPoint",
        {% if organization.telephone %}"telephone": {{ organization.telephone | json | safe }},{% endif %}
        {% if organization.email %}"email": {{ organization.email | json | safe }},{% endif %}
        "contactType": "sales",
        "availableLanguage": ["Polish"]
      }]
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": {{ (site.url + '#website') | json | safe }},
      "url": {{ site.url | json | safe }},
      "name": {{ site.name | json | safe }},
      "description": {{ site.description | json | safe }},
      "publisher": {
        "@id": {{ organizationId | json | safe }}
      },
      "inLanguage": {{ pageLocale | json | safe }}
    }
    </script>
    {% if isPrimaryServicePage %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "@id": {{ (canonicalUrl + '#service') | json | safe }},
      "name": {{ pageHeading | json | safe }},
      "url": {{ canonicalUrl | json | safe }},
      "description": {{ metaDescription | json | safe }},
      "provider": {
        "@id": {{ organizationId | json | safe }}
      },
      "serviceType": {{ pageHeading | json | safe }},
      "areaServed": [
        { "@type": "City", "name": "Warsaw" },
        { "@type": "Country", "name": "Poland" }
      ],
      "availableLanguage": ["Polish"]
    }
    </script>
    {% endif %}
    {% if isContact %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ContactPage",
      "@id": {{ (canonicalUrl + '#contact-page') | json | safe }},
      "url": {{ canonicalUrl | json | safe }},
      "name": {{ pageHeading | json | safe }},
      "description": {{ metaDescription | json | safe }},
      "about": {
        "@id": {{ organizationId | json | safe }}
      }
    }
    </script>
    {% endif %}
    {% set effectiveFaqSchema = faqSchema if faqSchema and faqSchema.length else (faq.items if isFaqPage and faq and faq.items and faq.items.length else []) %}
    {% if effectiveFaqSchema and effectiveFaqSchema.length %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {% for item in effectiveFaqSchema %}
        {
          "@type": "Question",
          "name": {{ item.question | json | safe }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ item.answer | json | safe }}
          }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    }
    </script>
    {% endif %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ breadcrumbHomeLabel | json | safe }},
          "item": {{ (site.url + breadcrumbHomeUrl) | json | safe }}
        }
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ pageHeading | json | safe }},
          "item": {{ canonicalUrl | json | safe }}
        }
      ]
    }
    </script>
    {% endif %}
    <style>
      :root {
        color-scheme: light;
        --cc-bg: #F8FAFC;
        --cc-surface: #FFFFFF;
        --cc-sidebar-surface: #F1F5F9;
        --cc-section-surface: #F8FAFC;
        --app-stage-bg-rgb: 248, 250, 252;
        --cc-border: #E5E7EB;
        --brand-navy: #00296b;
        --brand-blue-deep: #0E7441;
        --brand-blue: #118C4F;
        --brand-gold: #fdc500;
        --brand-gold-bright: #ffd500;
        --brand-navy-rgb: 0, 41, 107;
        --brand-blue-rgb: 17, 140, 79;
        --brand-gold-rgb: 253, 197, 0;
        --brand-gold-bright-rgb: 255, 213, 0;
        --cc-primary: var(--brand-blue);
        --cc-primary-hover: #0E7441;
        --cc-success: var(--brand-gold-bright);
        --cc-warning: #D97706;
        --cc-error: #DC2626;
        --cc-text: #0A0A0A;
        --cc-text-secondary: #64748B;
        --cc-muted: #94A3B8;
        --cc-hover: #F1F5F9;
        --cc-selected: #F8FAFF;
        --cc-progress-bg: #E5E7EB;
        --button-shadow: none;
        --button-shadow-hover: none;
        --brand-green: var(--brand-blue);
        --brand-green-soft: var(--brand-blue-deep);
        --brand-green-dark: var(--brand-navy);
        --brand-green-rgb: 17, 140, 79;

        --bg: var(--cc-bg);
        --surface: var(--cc-surface);
        --surface-soft: var(--cc-sidebar-surface);
        --border: var(--cc-border);
        --text: var(--cc-text);
        --muted: var(--cc-text-secondary);
        --muted-soft: var(--cc-muted);
        --text-strong: #0f172a;
        --text-body: #334155;
        --text-subtle: #64748b;
        --primary: var(--cc-primary);
        --primary-soft: var(--brand-green-soft);
        --primary-dark: var(--cc-primary);
        --primary-rgb: var(--brand-green-rgb);
        --accent-tech: var(--brand-navy);
        --accent-tech-dark: var(--brand-navy);
        --accent-tech-rgb: var(--brand-navy-rgb);
        --highlight: var(--brand-gold-bright);
        --highlight-soft: var(--brand-gold);
        --highlight-rgb: var(--brand-gold-bright-rgb);
        --ring: rgba(var(--brand-green-rgb), 0.28);
        --shadow: var(--button-shadow);
        --radius: 16px;
        --radius-sm: 12px;
        --radius-full: 999px;
        --btn-radius: 999px;
        --btn-height: 42px;
        --font-sans: ui-sans-serif, system-ui, sans-serif, "Apple Color Emoji", "Segoe UI Emoji",
          "Segoe UI Symbol", "Noto Color Emoji";
        --font-weight-regular: 400;
        --font-weight-medium: 500;
        --font-weight-semibold: 600;
        --font-weight-bold: 700;
        --container: 1120px;
        --header-height: 76px;
        --space-2xs: 8px;
        --space-xs: 12px;
        --space-sm: 16px;
        --space-md: 24px;
        --space-lg: 32px;
        --space-xl: 48px;
        --space-2xl: 64px;
        --space-section: clamp(64px, 7vw, 88px);
        --space-section-compact: clamp(44px, 5.5vw, 64px);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--font-sans), sans-serif;
        background: var(--bg);
        color: var(--text-strong);
        font-size: 16px;
        line-height: 1.6;
        letter-spacing: -0.011em;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      a {
        color: var(--text-strong);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      .material-symbols-rounded {
        width: 1.05em;
        height: 1.05em;
        vertical-align: -0.16em;
        stroke: currentColor;
        fill: none;
        user-select: none;
        color: currentColor;
      }

      .btn .material-symbols-rounded,
      .mobile-nav-cta .material-symbols-rounded {
        margin-right: 2px;
      }

      .btn--icon-right .material-symbols-rounded {
        margin-right: 0;
        margin-left: 2px;
        vertical-align: 0;
      }

      .btn-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 14px;
        height: 14px;
        flex: 0 0 14px;
      }

      .btn-icon svg {
        width: 14px;
        height: 14px;
        display: block;
        stroke: currentColor;
      }

      .btn-icon--roadmap {
        width: 15px;
        height: 15px;
        flex: 0 0 15px;
        background-color: currentColor;
        -webkit-mask-image: url("/images/icons/material-symbols/ai-roadmap.svg");
        mask-image: url("/images/icons/material-symbols/ai-roadmap.svg");
        -webkit-mask-repeat: no-repeat;
        mask-repeat: no-repeat;
        -webkit-mask-position: center;
        mask-position: center;
        -webkit-mask-size: contain;
        mask-size: contain;
      }

      .btn .btn-icon--roadmap {
        margin-right: 2px;
      }

      .btn-see-services {
        gap: 7px;
        padding: 10px 14px 10px 16px;
        letter-spacing: -0.005em;
      }

      .skip-link {
        position: absolute;
        left: 16px;
        top: 10px;
        padding: 10px 14px;
        border-radius: var(--radius-full);
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--text);
        box-shadow: var(--shadow);
        transform: translateY(-160%);
        transition: transform 180ms ease;
        z-index: 100;
      }

      .skip-link:focus {
        transform: translateY(0);
      }

      .cookie-banner {
        position: fixed;
        left: 16px;
        right: 16px;
        bottom: 16px;
        z-index: 200;
        border-radius: var(--radius);
        border: 1px solid rgba(226, 232, 240, 0.95);
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(10px);
        box-shadow: 0 18px 40px rgba(2, 6, 23, 0.12);
      }

      .cookie-banner[hidden] {
        display: none;
      }

      .cookie-fab {
        position: fixed;
        left: 16px;
        bottom: 16px;
        z-index: 190;
        width: 44px;
        height: 44px;
        border-radius: 999px;
        border: 1px solid rgba(226, 232, 240, 0.95);
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(10px);
        box-shadow: 0 18px 40px rgba(2, 6, 23, 0.12);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: var(--text);
      }

      .cookie-fab:hover {
        background: rgba(255, 255, 255, 0.98);
      }

      .cookie-fab:focus-visible {
        outline: 3px solid var(--ring);
        outline-offset: 2px;
      }

      .cookie-fab .material-symbols-rounded {
        font-size: 22px;
        vertical-align: 0;
      }

      .cookie-fab[hidden] {
        display: none;
      }

      .cookie-inner {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 12px;
        padding: 14px 14px;
      }

      .cookie-title {
        margin: 0 0 6px;
        font-size: 13px;
        font-weight: 850;
        letter-spacing: -0.01em;
        color: var(--text);
      }

      .cookie-text {
        margin: 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.7;
        max-width: 92ch;
      }

      .cookie-settings {
        margin-top: 12px;
        display: grid;
        gap: 10px;
      }

      .cookie-settings[hidden] {
        display: none;
      }

      .cookie-setting {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 12px;
        border-radius: 14px;
        border: 1px solid rgba(226, 232, 240, 0.95);
        background: rgba(248, 250, 252, 0.72);
      }

      .cookie-setting-title {
        margin: 0;
        color: var(--text);
        font-size: 12px;
        font-weight: 850;
        letter-spacing: -0.01em;
      }

      .cookie-setting-desc {
        margin: 2px 0 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.55;
      }

      .cookie-switch {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 26px;
        border-radius: 999px;
        border: 1px solid rgba(148, 163, 184, 0.75);
        background: rgba(226, 232, 240, 0.75);
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
        flex: 0 0 auto;
      }

      .cookie-switch input {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
      }

      .cookie-switch-thumb {
        width: 20px;
        height: 20px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.95);
        border: 1px solid rgba(148, 163, 184, 0.45);
        transform: translateX(-9px);
        transition: transform 160ms ease, border-color 160ms ease;
        box-shadow: 0 10px 20px rgba(2, 6, 23, 0.14);
      }

      .cookie-switch.is-on .cookie-switch-thumb,
      .cookie-switch input:checked + .cookie-switch-thumb {
        transform: translateX(9px);
        border-color: rgba(15, 23, 42, 0.85);
      }

      .cookie-switch.is-on {
        border-color: rgba(15, 23, 42, 0.85);
        background: rgba(15, 23, 42, 0.92);
      }

      .cookie-switch input:focus-visible + .cookie-switch-thumb {
        outline: 3px solid var(--ring);
        outline-offset: 2px;
      }

      .cookie-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
      }

      .cookie-link {
        color: var(--muted);
        font-weight: 700;
        font-size: 12px;
      }

      .cookie-link:hover {
        color: var(--text);
      }

      @media (min-width: 860px) {
        .cookie-inner {
          grid-template-columns: minmax(0, 1fr) auto;
          align-items: center;
        }

        .cookie-actions {
          justify-content: flex-end;
        }
      }

      .container {
        width: 100%;
        max-width: var(--container);
        margin: 0 auto;
        padding: 0 clamp(14px, 2vw, 20px);
      }

      .site {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(248, 250, 252, 0.84);
        border-bottom: 1px solid rgba(226, 232, 240, 0.9);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        transition:
          background 220ms ease,
          border-color 220ms ease,
          backdrop-filter 220ms ease,
          -webkit-backdrop-filter 220ms ease,
          box-shadow 220ms ease,
          transform 220ms ease;
      }

      .site-header--overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        background: transparent;
        border-bottom: 1px solid transparent;
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
        box-shadow: none;
      }

      .site-header--overlay.is-scrolled {
        position: fixed;
        background: rgba(248, 250, 252, 0.92);
        border-bottom: 1px solid rgba(226, 232, 240, 0.9);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
      }

      .site-header--overlay:not(.is-scrolled) .nav-link,
      .site-header--overlay:not(.is-scrolled) .mobile-nav-trigger {
        color: var(--text-strong);
      }

      .site-header--overlay:not(.is-scrolled) .brand-wordmark {
        color: var(--text-strong);
      }

      .site-header--overlay:not(.is-scrolled) .nav-link:hover {
        color: var(--text-strong);
        background: transparent;
      }

      .site-header--overlay:not(.is-scrolled) .nav-link.is-active,
      .site-header--overlay:not(.is-scrolled) .nav-item--mega .nav-link.is-active {
        color: var(--text-strong);
