      .nav-chevron {
        display: inline-flex;
        align-self: center;
        width: 12px;
        height: 12px;
        transform: translateY(0.5px) rotate(0deg);
        transform-origin: 50% 50%;
        opacity: 0.62;
        transition:
          transform 240ms cubic-bezier(0.22, 1, 0.36, 1),
          opacity 200ms ease-in-out;
