      .mega-menu {
        position: fixed;
        top: calc(var(--header-height) - 1px);
        left: 50%;
        width: calc(100vw - 28px);
        max-width: 1560px;
        padding: var(--space-sm);
        border-radius: var(--radius);
        border: 1px solid rgba(148, 163, 184, 0.26);
        background: rgba(255, 255, 255, 0.98);
        box-shadow:
          0 18px 36px rgba(2, 6, 23, 0.10),
          0 2px 6px rgba(2, 6, 23, 0.04);
        backdrop-filter: blur(6px);
        opacity: 0;
        visibility: hidden;
        transform: translate(-50%, 6px) scale(0.985);
        transition:
          opacity 240ms ease-in-out,
          transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
          visibility 0s linear 220ms;
        z-index: 80;
      }

      .mega-menu::before {
        content: "";
        position: absolute;
        left: 14px;
        right: 14px;
        top: 0;
        height: 2px;
        border-radius: 2px;
        background: linear-gradient(90deg, rgba(var(--accent-tech-rgb), 0.66), rgba(var(--primary-rgb), 0.44));
        pointer-events: none;
      }

      .nav-item--mega:hover .mega-menu,
      .nav-item--mega:focus-within .mega-menu,
      .nav-item--mega .mega-menu:hover,
      .nav-item--mega .mega-menu:focus-within {
        opacity: 1;
        visibility: visible;
        transform: translate(-50%, 0) scale(1);
        transition-delay: 0s, 0s, 0s;
      }

      .mega-menu-head {
