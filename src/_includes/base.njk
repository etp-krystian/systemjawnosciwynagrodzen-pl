        gap: 10px;
        padding: 14px;
        border-radius: 12px;
        border: 1px solid rgba(226, 232, 240, 0.92);
        background: rgba(255, 255, 255, 1);
        min-height: 100%;
        box-shadow: 0 2px 8px rgba(2, 6, 23, 0.03);
        transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
