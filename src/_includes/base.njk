        }

        .prose .usecase-kpi-grid {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .about-photo img {
          aspect-ratio: 4 / 3;
          object-fit: cover;
        }
      }

      @media (max-width: 980px) {
        .is-lead-plan .leadplan-hero-image {
          display: none;
        }

        .is-lead-plan .leadplan-hero {
          grid-template-columns: 1fr;
          gap: var(--space-sm);
        }

        .is-lead-plan .leadplan-flow {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .services-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .mega-menu {
          width: calc(100vw - 24px);
        }

        .mega-menu-groups {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .mega-menu-quickstart {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .footer-grid {
          grid-template-columns: minmax(0, 1fr);
        }

        .footer-upper {
          grid-template-columns: minmax(0, 1fr);
          min-height: 0;
        }

        .footer-links {
          justify-content: flex-start;
        }

        .info-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .value-panel {
          grid-template-columns: minmax(0, 1fr);
        }

        .value-panel:nth-child(even) .value-panel-copy,
        .value-panel:nth-child(even) .value-panel-visual {
          order: initial;
        }

        .partner {
          grid-template-columns: minmax(0, 1fr);
        }

        .home-hero {
          padding-top: calc(var(--space-lg) + var(--header-height));
          padding-bottom: calc(var(--space-xl) + var(--space-sm));
        }

        .home-module-showcase {
          min-height: auto;
        }

        .home-module-showcase .container {
          min-height: auto;
        }

        .blog-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .feature-columns {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .footer-side {
          justify-items: start;
        }

        .footer-payments {
          justify-content: flex-start;
        }
      }

      @media (max-width: 760px) {
        .home-assessment-promo {
          right: 16px;
          bottom: 16px;
          width: calc(100vw - 32px);
          padding: 16px;
        }

        .home-assessment-promo.is-collapsed {
          right: 0;
          width: auto;
          padding: 0;
        }

        .home-module-showcase {
          padding: 32px 0 20px;
        }

        .home-module-showcase-header h2 {
          margin-bottom: 10px;
        }

        .home-module-showcase-frame {
          margin-top: 10px;
          border-radius: 18px;
        }

        .is-lead-plan .leadplan-flow {
          grid-template-columns: 1fr;
        }

        .is-services-index .services-grid-showcase {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      @media (max-width: 860px) {
        .nav,
        .header-actions {
          display: none;
        }

        .mobile-nav {
          display: block;
        }

        .content-page-layout--with-aside {
          grid-template-columns: minmax(0, 1fr);
        }

        .content-related {
          position: static;
          top: auto;
          margin-top: var(--space-md);
        }
      }

      @media (max-width: 560px) {
        .container {
          padding: 0 14px;
        }

        .home-module-showcase-header p {
          font-size: 16px;
          line-height: 1.55;
        }

        .home-module-showcase-frame {
          border-radius: 16px;
        }

        .home-cta .btn {
          width: 100%;
          justify-content: center;
        }

        .is-services-index .services-intro,
        .is-services-index .service-cluster,
        .is-services-index .services-cta {
          padding: var(--space-sm);
        }

        .mega-menu-groups {
          grid-template-columns: minmax(0, 1fr);
        }

        .mega-menu-quickstart,
        .prose .trust-grid {
          grid-template-columns: minmax(0, 1fr);
        }

        .services-grid {
          grid-template-columns: minmax(0, 1fr);
        }

        .table-scroll {
          overflow-x: auto;
        }

        .prose .usecase-kpi-grid {
          grid-template-columns: minmax(0, 1fr);
        }

        .conversion-compare {
          grid-template-columns: minmax(0, 1fr);
        }

        .is-why-us .prose .whyus-intro,
        .is-why-us .prose .whyus-pillars {
          grid-template-columns: minmax(0, 1fr);
        }

        .stats {
          grid-template-columns: minmax(0, 1fr);
        }

        .info-grid {
          grid-template-columns: minmax(0, 1fr);
        }

        .value-panel {
          gap: 24px;
          padding: 28px;
        }

        .blog-grid {
          grid-template-columns: minmax(0, 1fr);
        }

        .feature-columns {
          grid-template-columns: minmax(0, 1fr);
        }

        .prose .visual-grid {
          grid-template-columns: minmax(0, 1fr);
        }

        .hero-scroll {
          bottom: -16px;
        }

        .hero-scroll-text {
          display: none;
        }
      }

      @media (min-width: 920px) {
        .home-hero-grid {
          grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
          gap: var(--space-xl);
          align-items: center;
        }

        .home-module-showcase .container {
          display: grid;
          grid-template-columns: minmax(280px, 0.72fr) minmax(0, 1.28fr);
          align-items: center;
          gap: clamp(24px, 4vw, 48px);
        }

        .home-module-showcase-header {
          max-width: 420px;
          margin: 0;
          text-align: left;
        }

        .home-module-showcase-frame {
          max-width: 100%;
          margin: 0;
        }

        .home-hero-grid--solo {
          grid-template-columns: minmax(0, 1fr);
        }

        .feature-panel {
          grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
          align-items: center;
          gap: 44px;
        }

        .feature-panel:nth-child(even) .feature-panel-copy {
          order: 2;
        }

        .feature-panel:nth-child(even) .visual-placeholder {
          order: 1;
        }

        .pricing-grid {
          grid-template-columns: repeat(3, minmax(0, 1fr));
          align-items: stretch;
        }

        .ai-loop-grid {
          grid-template-columns: minmax(0, 1fr) minmax(0, 440px);
          align-items: center;
        }

        .ai-loop-visual {
          display: flex;
          align-self: center;
        }

        .feature-switcher-grid {
          grid-template-columns: minmax(280px, 0.7fr) minmax(0, 1.7fr);
          gap: 34px;
        }
      }

    </style>
  </head>
  <body class="{% if isServices %}is-services{% endif %}{% if isServicesIndex %}{% if isServices %} {% endif %}is-services-index{% endif %}{% if isBlog %}{% if isServices or isServicesIndex %} {% endif %}is-blog{% endif %}{% if isContact %}{% if isServices or isServicesIndex or isBlog %} {% endif %}is-contact{% endif %}{% if isWhyUs %}{% if isServices or isServicesIndex or isBlog or isContact %} {% endif %}is-why-us{% endif %}{% if isLeadPlan %}{% if isServices or isServicesIndex or isBlog or isContact or isWhyUs %} {% endif %}is-lead-plan{% endif %}{% if isAssessment %}{% if isServices or isServicesIndex or isBlog or isContact or isWhyUs or isLeadPlan %} {% endif %}is-assessment{% endif %}{% if isContent %}{% if isServices or isServicesIndex or isBlog or isContact or isWhyUs or isLeadPlan or isAssessment %} {% endif %}is-content{% endif %}">
    <a class="skip-link" href="#main">{% if isPolish %}Przejdź do treści{% else %}Skip to content{% endif %}</a>
    <div class="site">
      <header class="site-header{% if isHome %} site-header--overlay{% endif %}" aria-label="Primary navigation">
        <div class="container header-inner">
          <a href="{{ homeUrl }}" class="brand" aria-label="System Jawności Wynagrodzeń">
            <span class="brand-logo" aria-hidden="true">
              <img src="/images/logo.svg" alt="" width="34" height="34" />
            </span>
            <span class="brand-wordmark">System Jawności Wynagrodzeń</span>
          </a>

          <nav class="nav" aria-label="Primary">
            <span class="nav-item">
              <a href="/funkcje/" class="nav-link{% if page.url == '/funkcje/' %} is-active{% endif %}">{{ featuresLabel }}</a>
            </span>
            <span class="nav-item">
              <a href="/cennik/" class="nav-link{% if page.url == '/cennik/' %} is-active{% endif %}">{{ pricingLabel }}</a>
            </span>
          </nav>

          <div class="header-actions">
            <a href="{{ signupUrl }}" class="btn btn-ghost" target="_blank" rel="noopener noreferrer" data-signup-conversion="true">
              <span>{{ signupLabel }}</span>
            </a>
            <a href="{{ loginUrl }}" class="btn btn-primary" target="_blank" rel="noopener noreferrer">
              <span>{{ loginLabel }}</span>
            </a>
          </div>

          <details class="mobile-nav">
            <summary class="mobile-nav-trigger">
              <span class="mobile-nav-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4 7H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                  <path d="M4 12H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                  <path d="M4 17H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
              </span>
              <span>{{ menuLabel }}</span>
            </summary>
            <div class="mobile-nav-panel" role="dialog" aria-label="Mobile navigation">
              <a href="/funkcje/">
                <span>{{ featuresLabel }}</span>
              </a>
              <a href="/cennik/">
                <span>{{ pricingLabel }}</span>
              </a>
              <a class="mobile-nav-cta" href="{{ signupUrl }}" target="_blank" rel="noopener noreferrer" data-signup-conversion="true">
                <span>{{ signupLabel }}</span>
              </a>
            </div>
          </details>
        </div>
      </header>

      <main id="main">
        {% if isHome %}
          <aside class="home-assessment-promo" id="home-assessment-promo" aria-label="Ocena gotowości organizacji" data-href="/ocena-gotowosci-organizacji/" tabindex="0">
            <div class="home-assessment-promo-body">
              <button
                class="home-assessment-promo-close"
                id="home-assessment-promo-close"
                type="button"
                aria-label="Minimalizuj"
              >
                &#215;
              </button>
              <p>Sprawdź gotowość organizacji do jawności wynagrodzeń.</p>
              <a href="/ocena-gotowosci-organizacji/">Przejdź do oceny</a>
            </div>
            <div class="home-assessment-promo-tab" aria-hidden="true">Ocena gotowości</div>
          </aside>

          <section class="home-hero">
            <div class="container">
              <div class="home-hero-grid home-hero-grid--solo">
                <div>
                  <h1>
                    Przygotuj firmę
                    <span>do jawności wynagrodzeń</span>
                  </h1>
                  <p class="home-lead">
                    System do zarządzania stanowiskami, widełkami płac i wartościowaniem pracy, który zamienia trudny proces w szybkie i proste wdrożenie.
                  </p>
                  <div class="home-cta home-cta--hero">
                    <a href="{{ signupUrl }}" class="btn btn-primary" target="_blank" rel="noopener noreferrer" data-signup-conversion="true">
                      <span>{{ heroPrimaryCtaLabel }}</span>
                    </a>
                  </div>
                  <p class="home-cta-reassurance">7 dni za darmo. Karta nie jest wymagana.</p>
                </div>
                <div class="home-demo-frame">
                  <video
                    class="home-demo-video"
                    autoplay
                    muted
                    loop
                    playsinline
                    controls
                    preload="metadata"
                  >
                    <source src="/images/sjw-demo.mp4" type="video/mp4" />
                  </video>
                </div>
              </div>
            </div>
          </section>

          <section class="feature-switcher" aria-labelledby="feature-switcher-heading">
            <div class="container">
                <div class="section-header">
                  <h2 id="feature-switcher-heading" class="section-title">Najważniejsze obszary systemu</h2>
                </div>
                <div class="feature-switcher-grid" id="feature-switcher">
                  <div class="feature-switcher-list" role="tablist" aria-labelledby="feature-switcher-heading">
                  <button
                    class="feature-switcher-item is-active"
                    type="button"
                    role="tab"
                    aria-selected="true"
                    aria-expanded="true"
                    aria-controls="feature-switcher-panel"
                    data-feature-index="0"
                    data-feature-image="/images/organizacja.jpg"
                    data-feature-image-alt="Widok modułu organizacji i struktury organizacyjnej w systemie"
                  >
                    <span class="feature-switcher-item-top">
                      <span class="feature-switcher-item-title">Organizacja</span>
                      <span class="feature-switcher-item-arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                          <path d="M6 9l6 6 6-6"></path>
                        </svg>
                      </span>
                    </span>
                    <span class="feature-switcher-item-copy">
                      <span class="feature-switcher-item-copy-inner">
                        <p>Zawiera informacje o organizacji, strukturę organizacji oraz stanowiska.</p>
                      </span>
                    </span>
                  </button>
                  <button
                    class="feature-switcher-item"
                    type="button"
                    role="tab"
                    aria-selected="false"
                    aria-expanded="false"
                    aria-controls="feature-switcher-panel"
                    data-feature-index="1"
                    data-feature-image="/images/kryteria-wartosciowania.jpg"
                    data-feature-image-alt="Widok modułu kryteriów wartościowania w systemie"
                  >
                    <span class="feature-switcher-item-top">
                      <span class="feature-switcher-item-title">Wartościowanie</span>
                      <span class="feature-switcher-item-arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                          <path d="M6 9l6 6 6-6"></path>
                        </svg>
                      </span>
                    </span>
                    <span class="feature-switcher-item-copy">
                      <span class="feature-switcher-item-copy-inner">
                        <p>Moduł zawiera narzędzia niezbędne do wartościowania stanowisk oraz bieżącej ewaluacji płac zgodnie z dyrektywą.</p>
                      </span>
                    </span>
                  </button>
                  <button
                    class="feature-switcher-item"
                    type="button"
                    role="tab"
                    aria-selected="false"
                    aria-expanded="false"
                    aria-controls="feature-switcher-panel"
                    data-feature-index="2"
                    data-feature-image="/images/pracownicy.jpg"
                    data-feature-image-alt="Widok modułu pracowników i danych pracownika w systemie"
                  >
                    <span class="feature-switcher-item-top">
                      <span class="feature-switcher-item-title">Pracownicy</span>
                      <span class="feature-switcher-item-arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                          <path d="M6 9l6 6 6-6"></path>
                        </svg>
                      </span>
                    </span>
                    <span class="feature-switcher-item-copy">
                      <span class="feature-switcher-item-copy-inner">
                        <p>Moduł zawiera informacje o pracownikach, ich płace vs płace wynikające z poziomów, oceny pracownika oraz jego historię.</p>
                      </span>
                    </span>
                  </button>
                  <button
                    class="feature-switcher-item"
                    type="button"
                    role="tab"
                    aria-selected="false"
                    aria-expanded="false"
                    aria-controls="feature-switcher-panel"
                    data-feature-index="3"
                    data-feature-image="/images/raporty.jpg"
                    data-feature-image-alt="Widok modułu raportów i porównania wynagrodzeń realnych vs modelowych"
                  >
                    <span class="feature-switcher-item-top">
                      <span class="feature-switcher-item-title">Raporty</span>
                      <span class="feature-switcher-item-arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                          <path d="M6 9l6 6 6-6"></path>
                        </svg>
                      </span>
                    </span>
                    <span class="feature-switcher-item-copy">
                      <span class="feature-switcher-item-copy-inner">
                        <p>Raporty pozwalają generować zestawienia wymagane przez dyrektywę oraz łatwo przekazywać informacje o wynagrodzeniach i sposobie ich liczenia.</p>
                      </span>
                    </span>
                  </button>
                </div>
                <div
                  class="feature-switcher-visual"
                  role="tabpanel"
                  id="feature-switcher-panel"
                  aria-labelledby="feature-switcher-heading"
                >
                  <div class="feature-switcher-placeholder" aria-label="Obraz dla aktywnego modułu">
                    <img
                      id="feature-switcher-image"
                      src=""
                      alt=""
                      hidden
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                </div>
              </div>
            </div>
          </section>

          <section class="home-module-showcase" aria-labelledby="employee-review-showcase-heading">
            <div class="container">
              <div class="home-module-showcase-header">
                <h2 id="employee-review-showcase-heading">Ocena okresowa pracownika</h2>
                <p>Moduł pokazuje wynik oceny na tle wymagań stanowiska oraz szczegółową punktację dla poszczególnych kryteriów.</p>
              </div>
              <div class="home-module-showcase-frame">
                <video
                  class="home-module-showcase-video"
                  autoplay
                  muted
                  loop
                  playsinline
                  controls
                  preload="metadata"
                >
                  <source src="/images/pracownicy-ocena-okresowa.mp4" type="video/mp4" />
                </video>
              </div>
            </div>
          </section>

          {% if collections.aktualnosci and collections.aktualnosci.length %}
            <section class="section compact" aria-labelledby="homepage-aktualnosci-heading">
              <div class="container">
                <div class="section-header pricing-section-header">
                  <div class="section-header section-header--split">
                    <h2 id="homepage-aktualnosci-heading" class="section-title">Aktualności</h2>
                    <a class="btn btn-ghost section-header-link" href="/aktualnosci/">
                      <span>Więcej aktualności</span>
                      <span class="btn-icon" aria-hidden="true">
                        <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M3.5 8H12.5" stroke-width="1.8" stroke-linecap="round" />
                          <path d="M8.8 4.3L12.5 8L8.8 11.7" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </span>
                    </a>
                  </div>
                </div>
                <div class="blog-grid">
                  {% for post in collections.aktualnosci | reverse %}
                    {% if loop.index0 < 3 %}
                      <article class="blog-item">
                        <div class="post-card">
                          {% if post.data.coverImage %}
                            <a class="post-card-thumb" href="{{ post.url }}" aria-label="{{ post.data.title }}">
                              <img src="{{ post.data.coverImage }}" alt="" loading="lazy" decoding="async" />
                            </a>
                          {% else %}
                            <a class="post-card-thumb post-card-thumb--placeholder" href="{{ post.url }}" aria-label="{{ post.data.title }}"></a>
                          {% endif %}
                          <div class="post-card-content">
                            <p class="post-card-meta">{{ post.data.publishLabel or "Aktualność" }}</p>
                            <h3 class="post-card-title">
                              <a href="{{ post.url }}">{{ post.data.title }}</a>
                            </h3>
                            <p class="post-card-desc">{{ post.data.excerpt or post.data.description }}</p>
                          </div>
                        </div>
                      </article>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            </section>
          {% endif %}

          {% if faq and faq.homepageItems and faq.homepageItems.length %}
            <section class="section compact" aria-labelledby="homepage-faq-heading">
              <div class="container">
                <div class="section-header pricing-section-header">
                  <div class="section-header section-header--split">
                    <h2 id="homepage-faq-heading" class="section-title">Najczęściej zadawane pytania</h2>
                    <a class="btn btn-ghost section-header-link" href="/faq/">
                      <span>Zobacz wszystkie pytania</span>
                      <span class="btn-icon" aria-hidden="true">
                        <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M3.5 8H12.5" stroke-width="1.8" stroke-linecap="round" />
                          <path d="M8.8 4.3L12.5 8L8.8 11.7" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </span>
                    </a>
                  </div>
                </div>
                <div class="blog-grid">
                  {% for item in faq.homepageItems %}
                    <article class="blog-item">
                      <div class="post-card">
                        <div class="post-card-content">
                          <h3 class="post-card-title">
                            <a href="{{ item.href }}">{{ item.question }}</a>
                          </h3>
                          <p class="post-card-desc">{{ item.shortAnswer }}</p>
                        </div>
                      </div>
                    </article>
                  {% endfor %}
                </div>
              </div>
            </section>
          {% endif %}

        {% else %}
          {% if renderPageHeader is defined and renderPageHeader == false %}
            {{ content | safe }}
          {% else %}
            <section class="page-hero">
              <div class="container">
                {% if not (isBlog and not isBlogIndex) %}
                  <div class="page-hero-inner">
                    <div class="page-header">
                      <h1>{{ pageHeading | escape }}</h1>
                      {% if pageLead %}
                        <p class="page-lead">{{ pageLead | escape }}</p>
                      {% endif %}
                    </div>
                  </div>
                {% endif %}
              </div>
            </section>

            <section class="section">
              <div class="container">
                <div class="content-page-layout{% if relatedLinks and relatedLinks.length %} content-page-layout--with-aside{% endif %}">
                  <article class="prose">
                    {{ content | safe }}
                  </article>
                  {% if relatedLinks and relatedLinks.length %}
                    <aside class="content-related" aria-labelledby="content-related-heading">
                      <div class="section-header content-related-header">
                        <h2 id="content-related-heading" class="content-related-title">Powiązane tematy</h2>
                      </div>
                      <div class="content-related-list">
                        {% for item in relatedLinks %}
                          <article class="content-related-item">
                            <div class="post-card post-card--compact">
                              <div class="post-card-content">
                                <h3 class="post-card-title">
                                  <a href="{{ item.url }}">{{ item.title }}</a>
                                </h3>
                                {% if item.description %}
                                  <p class="post-card-desc">{{ item.description }}</p>
                                {% endif %}
                              </div>
                            </div>
                          </article>
                        {% endfor %}
                      </div>
                    </aside>
                  {% endif %}
                </div>
                {% if isServices and not isServicesIndex %}
                  {% set ctaTitle = "Porozmawiajmy o tym, czy System Jawności Wynagrodzeń ma sens dla Twojej firmy" if isPolish else "Need help deciding whether System Jawności Wynagrodzeń fits your company?" %}
                  {% set ctaBody = "Powiedz nam, jak dziś wyglądają stanowiska, płace i sposób uzasadniania różnic, a pomożemy ocenić dopasowanie i sensowny pierwszy krok." if isPolish else "Tell us how compensation works today and we will help you evaluate fit and the right first step." %}
                  {% set ctaButton = "Rejestracja" if isPolish else "Sign up" %}
                  <section class="service-page-cta" aria-label="Service contact call to action">
                    <h2>{{ ctaTitle }}</h2>
                    <p>{{ ctaBody }}</p>
                    <div class="home-cta">
                      <a class="btn btn-primary" href="{{ signupUrl }}" target="_blank" rel="noopener noreferrer" data-signup-conversion="true"><span>{{ ctaButton }}</span></a>
                    </div>
                  </section>
                {% endif %}
              </div>
            </section>
          {% endif %}
        {% endif %}
      </main>

      <footer class="site-footer">
        <div class="container footer-upper">
          <div class="footer-upper-column footer-upper-column--brand">
            <span class="footer-upper-logo">
              <img src="/images/logo.svg" alt="" width="34" height="34" />
            </span>
          </div>
          <div class="footer-upper-column footer-upper-menu">
            <p class="footer-upper-title">Produkt</p>
            <ul class="footer-upper-list">
              <li><a href="/aktualizacje/">Co nowego</a></li>
              <li><a href="/funkcje/">Funkcje</a></li>
              <li><a href="/cennik/">Cennik</a></li>
              <li><a href="/partnerzy/">Program partnerski</a></li>
            </ul>
          </div>
          <div class="footer-upper-column footer-upper-menu">
            <p class="footer-upper-title">Konto</p>
            <ul class="footer-upper-list">
              <li><a href="{{ loginUrl }}" target="_blank" rel="noopener noreferrer">Logowanie</a></li>
              <li><a href="{{ signupUrl }}" target="_blank" rel="noopener noreferrer" data-signup-conversion="true">Rejestracja</a></li>
            </ul>
          </div>
          <div class="footer-upper-column footer-upper-column--gdpr">
            <a class="footer-gdpr-link" href="https://commission.europa.eu/law/law-topic/data-protection_en" target="_blank" rel="noopener noreferrer" aria-label="General Data Protection Regulation">
              <img src="/images/gdpr.svg" alt="GDPR" width="56" height="56" />
            </a>
          </div>
        </div>
        <div class="container footer-grid">
          <div>
            <div>© 2026, Easy Tech Partners Sp z o.o.</div>
          </div>
          <div class="footer-payments" aria-label="Metody płatności">
            <span class="footer-payment-logo footer-payment-logo--payu" aria-label="PayU">
              <img src="/images/payu.svg" alt="PayU" loading="lazy" decoding="async" />
            </span>
            <span class="footer-payment-logo footer-payment-logo--visa" aria-label="Visa">
              <svg viewBox="0 0 120 40" role="img" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                <text x="0" y="29" fill="currentColor" font-size="30" font-weight="700" font-style="italic" letter-spacing="1">VISA</text>
              </svg>
            </span>
            <span class="footer-payment-logo footer-payment-logo--mc" aria-label="Mastercard">
              <svg viewBox="0 0 150 40" role="img" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                <circle class="mc-left" cx="24" cy="20" r="14"/>
                <circle class="mc-right" cx="40" cy="20" r="14"/>
                <text x="62" y="25" font-size="16" font-weight="600">mastercard</text>
              </svg>
            </span>
          </div>
          <div class="footer-side">
            <div class="footer-links" aria-label="Footer links">
              <a href="/faq/">FAQ</a>
              <a href="/polityka-prywatnosci/">{% if isPolish %}Polityka prywatności{% else %}Privacy policy{% endif %}</a>
              {% if isPolish %}
                <a href="/regulamin/">Regulamin</a>
              {% endif %}
            </div>
          </div>
        </div>
      </footer>
    </div>
    {% if isHome %}
      <script src="/js/home-assessment-promo.js" defer></script>
    {% endif %}
    <button
      class="cookie-fab"
      id="cookie-fab"
      type="button"
      aria-label="Cookie settings"
      hidden
    >
      {% ms "cookie" %}
    </button>
    <div
      class="cookie-banner"
      id="cookie-banner"
      role="dialog"
      aria-label="Cookie preferences"
      aria-live="polite"
      hidden
    >
      <div class="cookie-inner">
          <div>
            <p class="cookie-title">{% if isPolish %}Cookies{% else %}Cookies{% endif %}</p>
            <p class="cookie-text">
              {% if isPolish %}
                Używamy niezbędnych plików cookie, aby strona działała poprawnie. Za Twoją zgodą używamy także cookies analitycznych, aby rozumieć sposób korzystania ze strony i ją ulepszać.
                Swoją decyzję możesz zmienić w każdej chwili w ustawieniach cookies.
              {% else %}
                We use essential cookies to make this site work. With your permission, we also use analytics cookies to understand how the site is used and improve it.
                You can change your choice any time in Cookie settings.
              {% endif %}
            </p>
            <a class="cookie-link" href="/polityka-prywatnosci/">{% if isPolish %}Przeczytaj politykę cookies{% else %}Read our cookie policy{% endif %}</a>
            <div class="cookie-settings" id="cookie-settings" hidden>
              <div class="cookie-setting">
                <div>
                  <p class="cookie-setting-title">{% if isPolish %}Niezbędne{% else %}Necessary{% endif %}</p>
                  <p class="cookie-setting-desc">{% if isPolish %}Wymagane do działania strony.{% else %}Required for the site to function.{% endif %}</p>
                </div>
                <div class="cookie-switch is-on" aria-hidden="true" title="Necessary cookies are always on">
                  <span class="cookie-switch-thumb" aria-hidden="true"></span>
                </div>
              </div>
              <div class="cookie-setting">
                <div>
                  <p class="cookie-setting-title">{% if isPolish %}Analityczne{% else %}Analytics{% endif %}</p>
                  <p class="cookie-setting-desc">{% if isPolish %}Pomagają nam zrozumieć użycie strony i ją ulepszać (GA4).{% else %}Helps us understand usage and improve the site (GA4).{% endif %}</p>
                </div>
              <label class="cookie-switch" for="cookie-analytics-toggle">
                <input type="checkbox" id="cookie-analytics-toggle" aria-label="{% if isPolish %}Włącz analityczne pliki cookie{% else %}Enable analytics cookies{% endif %}" />
                <span class="cookie-switch-thumb" aria-hidden="true"></span>
              </label>
              </div>
            </div>
          </div>
        <div class="cookie-actions">
          <button class="btn btn-ghost" type="button" data-cookie-reject>{% if isPolish %}Odrzuć{% else %}Reject{% endif %}</button>
          <button class="btn btn-ghost" type="button" data-cookie-customize>{% if isPolish %}Dostosuj{% else %}Customize{% endif %}</button>
          <button class="btn btn-primary" type="button" data-cookie-accept>{% if isPolish %}Akceptuj cookies{% else %}Accept cookies{% endif %}</button>
        </div>
      </div>
    </div>
  {% if isHome %}
    <script src="/js/header-scroll.js" defer></script>
    <script src="/js/ai-loop.js" defer></script>
    <script src="/js/feature-switcher.js" defer></script>
  {% endif %}
  {% if isServices and not isServicesIndex %}
    <script src="/js/faq-accordion.js" defer></script>
    <script src="/js/related-services.js" defer></script>
  {% endif %}
    <script src="/js/cookie-consent.js" defer></script>
  </body>
</html>
